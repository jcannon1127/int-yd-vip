<isdecorate template="common/layout/page">
    <isscript>var assets = require('*/cartridge/scripts/assets.js'); assets.addCss('/css/vip.css');</isscript>
    <div class="container vip-page">
        <isif condition="${pdict.welcomeBody}">
            <isprint value="${pdict.welcomeBody}" encoding="off"/>
        <iselse/>
            <div class="vip-card" style="text-align:center;"><h1>Welcome to ${pdict.tier.name} VIP</h1><p>Your member pricing is now on.</p></div>
        </isif>
        <div style="max-width:480px;margin:1.4rem auto 0;background:#4B5D3A;color:#fff;border-radius:14px;padding:1.3rem 1rem;text-align:center;">
            <p style="margin:0 0 .4rem;font-size:.8rem;letter-spacing:.12em;text-transform:uppercase;opacity:.85;">Your welcome gift</p>
            <p style="margin:0 0 .5rem;font-size:1.25rem;font-weight:700;">${pdict.tier.welcomePct} off your first order</p>
            <p style="margin:0;">Use code <span style="display:inline-block;background:#fff;color:#4B5D3A;font-weight:700;padding:.25rem .7rem;border-radius:8px;">${pdict.tier.welcomeCode}</span> at checkout &mdash; today only.</p>
        </div>
        <div style="text-align:center;margin-top:1.5rem;">
            <a href="${URLUtils.url('Home-Show')}" style="display:inline-block;background:#4B5D3A;color:#fff;padding:.7rem 2rem;border-radius:999px;text-decoration:none;font-size:1.05rem;">Start shopping as a VIP</a>
        </div>
    </div>
</isdecorate>
